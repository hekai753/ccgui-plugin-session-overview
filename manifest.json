{
  "id": "session-overview",
  "name": "会话总览",
  "version": "0.1.3",
  "minAppVersion": "1.1.3",
  "icon": "docs/icon.png",
  "screenshots": ["docs/screenshot.png"],
  "tier": "js",
  "author": "hekai753",
  "repo": "hekai753/ccgui-plugin-session-overview",
